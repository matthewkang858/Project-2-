  "lines": [
   {
    "id": "b01",
    "text": "In this town, the player used to protect us.",
    "spoken": "In this town, the player used to protect us.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "He fought every zombie that knocked on our door.",
    "spoken": "He fought every zombie that knocked on our door.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "When he slept, the night just ended.",
    "spoken": "When he slept, the night just ended.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "Every morning he crouched at me, twice.",
    "spoken": "Every morning he crouched at me, twice.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b05",
    "text": "That meant hello.",
    "spoken": "That meant hello.",
    "pause": 1.0,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "One day he put on his best armor and walked into the woods.",
    "spoken": "One day he put on his best armor and walked into the woods.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "He came back at sunrise without it.",
    "spoken": "He came back at sunrise without it.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "He didn't crouch.",
    "spoken": "He didn't crouch.",
    "pause": 1.3,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "Now he just stands around and watches us.",
    "spoken": "Now he just stands around and watches us.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "The grownups say players stand still sometimes.",
    "spoken": "The grownups say players stand still sometimes.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "I watch him back.",
    "spoken": "I watch him back.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "He used to take the trunk and leave the tree floating.",
    "spoken": "He used to take the trunk and leave the tree floating.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "Now he only takes the leaves.",
    "spoken": "Now he only takes the leaves.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "Nobody built the sand pyramid in the meadow.",
    "spoken": "Nobody built the sand pyramid in the meadow.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "Every time I look, he is one house closer.",
    "spoken": "Every time I look, he is one house closer.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "He doesn't sleep anymore.",
    "spoken": "He doesn't sleep anymore.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "The nights last all night.",
    "spoken": "The nights last all night.",
    "pause": 0.9,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "Last night a zombie knocked on our door until sunrise.",
    "spoken": "Last night a zombie knocked on our door until sunrise.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "He stood beside it and watched.",
    "spoken": "He stood beside it and watched.",
    "pause": 1.0,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "So this morning I walked up to him and waited for my hello.",
    "spoken": "So this morning I walked up to him and waited for my hello.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b21",
    "text": "He crouched, once, and he stayed down.",
    "spoken": "He crouched, once, and he stayed down.",
    "pause": 1.5,
    "speed": 0.9
   },
   {
    "id": "b22",
    "text": "The player had blue eyes.",
    "spoken": "The player had blue eyes.",
    "pause": 0.0,
    "speed": 0.9
   }
  ]
 },
