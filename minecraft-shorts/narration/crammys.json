  "lines": [
   {
    "id": "b01",
    "text": "In this town, everyone is musical except me.",
    "spoken": "In this town, everyone is musical except me.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "Zuri keeps her note block on wool, so she plays guitar.",
    "spoken": "Zoo-ree keeps her note block on wool, so she plays guitar.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "Kai keeps his on gold, so he plays bells.",
    "spoken": "Kai keeps his on gold, so he plays bells.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "Sunny keeps his on a pumpkin, and we don't talk about it.",
    "spoken": "Sunny keeps his on a pumpkin, and we don't talk about it.",
    "pause": 0.55,
    "speed": 1.0
   },
   {
    "id": "b05",
    "text": "Tonight was the Crammys, our biggest party of the year.",
    "spoken": "Tonight was the Crammys, our biggest party of the year.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "Everyone performs, and I never have anything.",
    "spoken": "Everyone performs, and I never have anything.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "I just get chased home every night.",
    "spoken": "I just get chased home every night.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "But a creeper drops a music disc if a skeleton kills it.",
    "spoken": "But a creeper drops a music disc if a skeleton kills it.",
    "pause": 0.55,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "So I walked out past the last torch.",
    "spoken": "So I walked out past the last torch.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "I found a creeper.",
    "spoken": "I found a creeper.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "I found a skeleton.",
    "spoken": "I found a skeleton.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "I stood in the middle.",
    "spoken": "I stood in the middle.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "The skeleton shot me.",
    "spoken": "The skeleton shot me.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "Then it shot me again.",
    "spoken": "Then it shot me again.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "Then it shot the creeper.",
    "spoken": "Then it shot the creeper.",
    "pause": 1.4,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "A disc dropped.",
    "spoken": "A disc dropped.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "I ran to the stage with arrows still in me.",
    "spoken": "I ran to the stage with arrows still in me.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "Nobody asked.",
    "spoken": "Nobody asked.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "I put my disc in the jukebox.",
    "spoken": "I put my disc in the jukebox.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "It was disc eleven, the broken one.",
    "spoken": "It was disc eleven, the broken one.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b21",
    "text": "It's just someone running away and breathing hard.",
    "spoken": "It's just someone running away and breathing hard.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b22",
    "text": "Nobody moved.",
    "spoken": "Nobody moved.",
    "pause": 1.15,
    "speed": 1.0
   },
   {
    "id": "b23",
    "text": "Kai said it sounded just like me coming home.",
    "spoken": "Kai said it sounded just like me coming home.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b24",
    "text": "I won Best Vocals.",
    "spoken": "I won Best Vocals.",
    "pause": 0.0,
    "speed": 1.0
   }
  ]
 },
