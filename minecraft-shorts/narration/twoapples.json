  "lines": [
   {
    "id": "b01",
    "text": "In this town, the player has an underground base.",
    "spoken": "In this town, the player has an underground base.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "My dad got taken down there.",
    "spoken": "My dad got taken down there.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "The player walked into him until he was downstairs.",
    "spoken": "The player walked into him until he was downstairs.",
    "pause": 0.65,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "That evening, I jumped on dad's bed.",
    "spoken": "That evening, I jumped on dad's bed.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b05",
    "text": "Nobody told me to stop.",
    "spoken": "Nobody told me to stop.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "So I went down to find him.",
    "spoken": "So I went down to find him.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "It's a trading hall, and dad has the last tiny room.",
    "spoken": "It's a trading hall, and dad has the last tiny room.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "The player keeps one zombie down here.",
    "spoken": "The player keeps one zombie down here.",
    "pause": 0.55,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "He pulls a lever, and dad's wall opens.",
    "spoken": "He pulls a lever, and dad's wall opens.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "The zombie runs in and hugs him.",
    "spoken": "The zombie runs in and hugs him.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "On Hard, we always turn.",
    "spoken": "On Hard, we always turn.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "Dad goes green under his hat.",
    "spoken": "Dad goes green under his hat.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "The player throws a potion and feeds him a golden apple.",
    "spoken": "The player throws a potion and feeds him a golden apple.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "He only ever brings one.",
    "spoken": "He only ever brings one.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "I always hope he'll bring two.",
    "spoken": "I always hope he'll bring two.",
    "pause": 0.65,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "Dad shakes for five minutes.",
    "spoken": "Dad shakes for five minutes.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "Then he's dad again, and Mending costs one emerald.",
    "spoken": "Then he's dad again, and Mending costs one emerald.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "Dad thinks the player saved him.",
    "spoken": "Dad thinks the player saved him.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "He never looks behind him.",
    "spoken": "He never looks behind him.",
    "pause": 0.85,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "Babies grow up in twenty minutes.",
    "spoken": "Babies grow up in twenty minutes.",
    "pause": 0.9,
    "speed": 1.0
   },
   {
    "id": "b21",
    "text": "I'm still small.",
    "spoken": "I'm still small.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b22",
    "text": "The night I came down, the zombie found me first.",
    "spoken": "The night I came down, the zombie found me first.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b23",
    "text": "The player only needs one zombie.",
    "spoken": "The player only needs one zombie.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b24",
    "text": "He kept the smaller one.",
    "spoken": "He kept the smaller one.",
    "pause": 0.0,
    "speed": 0.9
   }
  ]
 },
