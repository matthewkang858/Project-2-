  "lines": [
   {
    "id": "b01",
    "text": "In this bastion, I'm the only one who doesn't like gold.",
    "spoken": "In this bastion, I'm the only one who doesn't like gold.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "My brothers will stare at one ingot for six seconds.",
    "spoken": "My brothers will stare at one ingot for six seconds.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "Somebody has to guard the place.",
    "spoken": "Somebody has to guard the place.",
    "pause": 0.65,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "One day, a player ran in.",
    "spoken": "One day, a player ran in.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b05",
    "text": "He wore golden boots, so my brothers thought he was family.",
    "spoken": "He wore golden boots, so my brothers thought he was family.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "He dug a hole, and they fell in.",
    "spoken": "He dug a hole, and they fell in.",
    "pause": 0.65,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "He threw gold, and they threw back ender pearls.",
    "spoken": "He threw gold, and they threw back ender pearls.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "Mostly gravel.",
    "spoken": "Mostly gravel.",
    "pause": 0.9,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "I hit him with my axe.",
    "spoken": "I hit him with my axe.",
    "pause": 0.25,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "He turned into smoke, and the whole world ended.",
    "spoken": "He turned into smoke, and the whole world ended.",
    "pause": 0.2,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "New world, different bastion, same boots.",
    "spoken": "New world, different bastion, same boots.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "Every world has a bastion, and every bastion has me.",
    "spoken": "Every world has a bastion, and every bastion has me.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "He hid on a pillar and threw gold at me.",
    "spoken": "He hid on a pillar and threw gold at me.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "I looked at it for zero seconds.",
    "spoken": "I looked at it for zero seconds.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "I can wait, and he can't.",
    "spoken": "I can wait, and he can't.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "I ended a full stack of worlds.",
    "spoken": "I ended a full stack of worlds.",
    "pause": 0.9,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "I started waiting at the gate.",
    "spoken": "I started waiting at the gate.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "One day, he didn't come.",
    "spoken": "One day, he didn't come.",
    "pause": 1.1,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "He found an older version of the world, from before they added me.",
    "spoken": "He found an older version of the world, from before they added me.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "In that bastion, everyone likes gold.",
    "spoken": "In that bastion, everyone likes gold.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b21",
    "text": "So today I'm staring at an ingot.",
    "spoken": "So today I'm staring at an ingot.",
    "pause": 0.4,
    "speed": 0.9
   },
   {
    "id": "b22",
    "text": "Six seconds.",
    "spoken": "Six seconds.",
    "pause": 2.645,
    "speed": 0.9
   },
   {
    "id": "b23",
    "text": "Nothing.",
    "spoken": "Nothing.",
    "pause": 0.0,
    "speed": 0.9
   }
  ]
 },
