  "lines": [
   {
    "id": "b01",
    "text": "In this village, everyone is afraid of the player.",
    "spoken": "In this village, everyone is afraid of the player.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "I'm not.",
    "spoken": "I'm not.",
    "pause": 1.15,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "He only takes grownups.",
    "spoken": "He only takes grownups.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "My mom lives at the top of his glass tower now.",
    "spoken": "My mom livs at the top of his glass tower now.",
    "pause": 0.65,
    "speed": 0.95
   },
   {
    "id": "b05",
    "text": "I would wave, but our arms don't do that.",
    "spoken": "I would wave, but our arms don't do that.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "He gave her a bed, and a zombie in a box.",
    "spoken": "He gave her a bed, and a zombie in a box.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "The zombie can't reach her.",
    "spoken": "The zombie can't reach her.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "It doesn't have to.",
    "spoken": "It doesn't have to.",
    "pause": 0.95,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "When we get scared, an iron golem comes to save us.",
    "spoken": "When we get scared, an iron golem comes to save us.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "It comes every time.",
    "spoken": "It comes every time.",
    "pause": 0.65,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "The water pushes it into the lava.",
    "spoken": "The water pushes it into the lava.",
    "pause": 0.95,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "He takes the iron and leaves the poppies.",
    "spoken": "He takes the iron and leaves the poppies.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "He never took down his dirt staircase.",
    "spoken": "He never took down his dirt staircase.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "At the top there's a gap, one block high.",
    "spoken": "At the top there's a gap, one block high.",
    "pause": 0.4,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "Grownups don't fit, but I do.",
    "spoken": "Grownups don't fit, but I do.",
    "pause": 0.55,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "Mom never looks at me, only at the zombie.",
    "spoken": "Mom never looks at me, only at the zombie.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "Childhood here lasts twenty minutes.",
    "spoken": "Childhood here lasts twenty minutes.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "I spent mine with her.",
    "spoken": "I spent mine with her.",
    "pause": 0.9,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "I was still inside when it ended.",
    "spoken": "I was still inside when it ended.",
    "pause": 1.0,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "Now I don't fit.",
    "spoken": "Now I don't fit.",
    "pause": 0.85,
    "speed": 1.0
   },
   {
    "id": "b21",
    "text": "He counted us twice, then brought one more bed.",
    "spoken": "He counted us twice, then brought one more bed.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b22",
    "text": "I'm still not afraid of the player.",
    "spoken": "I'm still not afraid of the player.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b23",
    "text": "I'm afraid of the zombie.",
    "spoken": "I'm afraid of the zombie.",
    "pause": 0.75,
    "speed": 1.0
   },
   {
    "id": "b24",
    "text": "Apparently that counts.",
    "spoken": "Apparently that counts.",
    "pause": 0.0,
    "speed": 0.9
   }
  ]
 },
