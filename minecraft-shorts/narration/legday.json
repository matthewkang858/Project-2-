  "lines": [
   {
    "id": "b01",
    "text": "In this town, everyone wants to get ripped.",
    "spoken": "In this town, everyone wants to get ripped.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b02",
    "text": "Steve mines stone with his fists.",
    "spoken": "Steve mines stone with his fists.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b03",
    "text": "It drops nothing, and he counts that as one rep.",
    "spoken": "It drops nothing, and he counts that as one rep.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b04",
    "text": "There's a chicken farm, and a cow farm for protein shakes.",
    "spoken": "There's a chicken farm, and a cow farm for protein shakes.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b05",
    "text": "Milk doesn't even fill you up.",
    "spoken": "Milk doesn't even fill you up.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b06",
    "text": "I haven't told them.",
    "spoken": "I haven't told them.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b07",
    "text": "But I'm a redstoner.",
    "spoken": "But I'm a red-stoner.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b08",
    "text": "My arms are three pixels wide, and theirs are four.",
    "spoken": "My arms are three pixels wide, and theirs are four.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b09",
    "text": "Steve asked how much my piston lifts, and I said twelve blocks.",
    "spoken": "Steve asked how much my piston lifts, and I said twelve blocks.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b10",
    "text": "He said that's cheating.",
    "spoken": "He said that's cheating.",
    "pause": 0.6,
    "speed": 1.0
   },
   {
    "id": "b11",
    "text": "Every day they carry twelve anvils up the wall.",
    "spoken": "Every day they carry twelve anvils up the wall.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b12",
    "text": "They call it leg day.",
    "spoken": "They call it leg day.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b13",
    "text": "Under each anvil, I put a sticky piston.",
    "spoken": "Under each anvil, I put a sticky piston.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b14",
    "text": "Nobody asked why.",
    "spoken": "Nobody asked why.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b15",
    "text": "Then the pillagers came.",
    "spoken": "Then the pillagers came.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b16",
    "text": "Everyone ran out to punch them.",
    "spoken": "Everyone ran out to punch them.",
    "pause": 0.35,
    "speed": 1.0
   },
   {
    "id": "b17",
    "text": "Pillagers have crossbows, so everyone hid behind the cows.",
    "spoken": "Pillagers have crossbows, so everyone hid behind the cows.",
    "pause": 0.5,
    "speed": 1.0
   },
   {
    "id": "b18",
    "text": "I flipped one lever.",
    "spoken": "I flipped one lever.",
    "pause": 0.45,
    "speed": 1.0
   },
   {
    "id": "b19",
    "text": "Twelve pistons pulled back, and twelve anvils fell on the road.",
    "spoken": "Twelve pistons pulled back, and twelve anvils fell on the road.",
    "pause": 0.8,
    "speed": 1.0
   },
   {
    "id": "b20",
    "text": "That left a banner and a bottle.",
    "spoken": "That left a banner and a bottle.",
    "pause": 0.5,
    "speed": 0.9
   },
   {
    "id": "b21",
    "text": "Steve still says redstone is cheating.",
    "spoken": "Steve still says redstone is cheating.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b22",
    "text": "But they carried all twelve back up before dark.",
    "spoken": "But they carried all twelve back up before dark.",
    "pause": 0.365,
    "speed": 1.0
   },
   {
    "id": "b23",
    "text": "They call it leg day.",
    "spoken": "They call it leg day.",
    "pause": 0.7,
    "speed": 1.0
   },
   {
    "id": "b24",
    "text": "I call it reloading.",
    "spoken": "I call it reloading.",
    "pause": 0.0,
    "speed": 0.9
   }
  ]
 },
